      "targets": [
        {
          "dataset": "monitoring",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg0vtrrqg16o0d"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT n.sent_at                     AS \"Sent\",\n       n.channel                     AS \"Channel\",\n       COALESCE(ct.name, g.name)     AS \"Recipient\",\n       a.alert_name                  AS \"Alert\",\n       a.severity                    AS \"Severity\",\n       n.error_message               AS \"Error\"\nFROM notifications n\nJOIN alerts a        ON a.id = n.alert_id\nLEFT JOIN contacts ct ON ct.id = n.contact_id\nLEFT JOIN groups g    ON g.id = n.group_id\nWHERE $__timeFilter(n.sent_at)\n  AND n.status = 'failed'\n  AND n.channel IN ($channel)\nORDER BY n.sent_at DESC\nLIMIT 20;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Recent failed deliveries",
      "type": "table"
