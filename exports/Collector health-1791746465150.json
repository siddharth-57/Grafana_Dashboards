          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT max(string_to_array(version, '.')::int[]) AS v FROM collectors\n)\nSELECT count(*) AS \"Collectors\",\n       count(*) FILTER (WHERE last_heartbeat_at >= now() - interval '5 minutes') AS \"Healthy\",\n       count(*) FILTER (WHERE last_heartbeat_at <  now() - interval '5 minutes'\n                           OR last_heartbeat_at IS NULL)                        AS \"Stale\",\n       count(*) FILTER (WHERE string_to_array(version, '.')::int[] < latest.v)  AS \"Outdated\"\nFROM collectors, latest\nGROUP BY latest.v;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
