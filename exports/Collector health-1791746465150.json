          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT col.hostname                                         AS \"Host\",\n       c.name                                               AS \"Customer\",\n       s.sid || ' (' || s.system_type || ')'                AS \"System\",\n       col.version                                          AS \"Version\",\n       col.last_heartbeat_at                                AS \"Last heartbeat\",\n       EXTRACT(EPOCH FROM now() - col.last_heartbeat_at) / 60 AS \"Silent for\"\nFROM collectors col\nJOIN systems s   ON s.id = col.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE col.last_heartbeat_at < now() - interval '5 minutes'\n   OR col.last_heartbeat_at IS NULL\nORDER BY col.last_heartbeat_at NULLS FIRST;",
          "refId": "A",
          "sql": {
