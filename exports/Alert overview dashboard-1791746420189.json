          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT date_trunc('day',   now() AT TIME ZONE 'Asia/Kolkata') AT TIME ZONE 'Asia/Kolkata' AS today,\n         date_trunc('week',  now() AT TIME ZONE 'Asia/Kolkata') AT TIME ZONE 'Asia/Kolkata' AS week,\n         date_trunc('month', now() AT TIME ZONE 'Asia/Kolkata') AT TIME ZONE 'Asia/Kolkata' AS month\n)\nSELECT count(*) FILTER (WHERE fired_at >= b.today) AS \"Today\",\n       count(*) FILTER (WHERE fired_at >= b.week)  AS \"This week\",\n       count(*) FILTER (WHERE fired_at >= b.month) AS \"This month\"\nFROM alerts, b\nWHERE fired_at >= LEAST(b.week, b.month);",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
