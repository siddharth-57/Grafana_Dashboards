          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 day', fired_at, 'Asia/Kolkata') AS time,\n       count(*) FILTER (WHERE status IN ('open', 'cleared')) AS \"Notified\",\n       count(*) FILTER (WHERE status = 'flapping')           AS \"Flapping\",\n       count(*) FILTER (WHERE status = 'suspected_false')    AS \"Suspected false\",\n       count(*) FILTER (WHERE status = 'suppressed')         AS \"Suppressed\"\nFROM alerts\nWHERE $__timeFilter(fired_at)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
