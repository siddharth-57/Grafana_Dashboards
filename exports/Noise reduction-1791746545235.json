        {
          "dataset": "monitoring",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg0vtrrqg16o0d"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE EXISTS (SELECT 1 FROM notifications n WHERE n.alert_id = a.id))\n                                                                  AS \"Notified\",\n  count(*) FILTER (WHERE a.status IN ('suppressed', 'suspected_false'))\n                                                                  AS \"Filtered out\",\n  round(100.0 * count(*) FILTER (WHERE a.status IN ('suppressed', 'suspected_false'))\n        / NULLIF(count(*), 0), 1)                                 AS \"Filtered %\",\n  count(*) FILTER (WHERE a.status = 'flapping')                   AS \"Flapping\"\nFROM alerts a\nWHERE $__timeFilter(a.fired_at);",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Noise reduction summary",
      "type": "stat"
