          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT alert_type AS \"Alert type\",\n       avg(EXTRACT(EPOCH FROM cleared_at - fired_at)) AS \"Average\",\n       percentile_cont(0.5)  WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM cleared_at - fired_at)) AS \"Median\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM cleared_at - fired_at)) AS \"P95\"\nFROM alerts\nWHERE $__timeFilter(fired_at)\n  AND status IN ('cleared', 'flapping')\n  AND cleared_at IS NOT NULL\n  AND alert_type IN ($alert_type)\nGROUP BY 1\nORDER BY 2 DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Time to clear by alert type",
      "type": "barchart"
