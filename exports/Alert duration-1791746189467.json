          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS \"Customer\",\n       avg(EXTRACT(EPOCH FROM a.cleared_at - a.fired_at)) AS \"Average time to clear\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE $__timeFilter(a.fired_at)\n  AND a.status IN ('cleared', 'flapping')\n  AND a.cleared_at IS NOT NULL\n  AND a.alert_type IN ($alert_type)\nGROUP BY 1\nHAVING count(*) >= 5\nORDER BY 2 DESC\nLIMIT 15;",
          "refId": "A",
