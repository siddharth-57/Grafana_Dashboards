          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.sid || ' · ' || c.name                    AS \"System\",\n       a.alert_name                                AS \"Alert\",\n       a.severity                                  AS \"Severity\",\n       a.status                                    AS \"Status\",\n       a.fired_at                                  AS \"Fired\",\n       EXTRACT(EPOCH FROM now() - a.fired_at)      AS \"Open for\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE a.cleared_at IS NULL\n  AND a.alert_type IN ($alert_type)\nORDER BY a.fired_at\nLIMIT 15;",
          "refId": "A",
          "sql": {
