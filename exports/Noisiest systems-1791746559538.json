          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.sid || ' · ' || c.name                      AS \"System\",\n       s.system_type                                AS \"Type\",\n       count(*)                                     AS \"Alerts\",\n       count(*) FILTER (WHERE a.severity = 'critical') AS \"Critical\",\n       max(a.fired_at)                              AS \"Last alert\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE $__timeFilter(a.fired_at)\n  AND c.group_id IN ($group)\n  AND c.id IN ($customer)\nGROUP BY s.id, s.sid, c.name, s.system_type\nORDER BY 3 DESC\nLIMIT 20;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
