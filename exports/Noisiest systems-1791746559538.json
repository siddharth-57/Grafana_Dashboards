          "rawSql": "SELECT a.fired_at                AS \"Fired\",\n       s.sid || ' · ' || c.name  AS \"System\",\n       a.alert_name              AS \"Alert\",\n       a.status                  AS \"Status\",\n       a.occurrence_count        AS \"Occurrences\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE $__timeFilter(a.fired_at)\n  AND c.group_id IN ($group)\n  AND c.id IN ($customer)\nORDER BY a.occurrence_count DESC\nLIMIT 10;",
