          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(m.collected_at, $__interval),\n       s.sid || ' ' || s.system_type || ' · ' ||\n         replace(m.metric_name, '_available', '') AS metric,\n       min(m.value) AS value\nFROM metrics m\nJOIN systems s ON s.id = m.system_id\nWHERE $__timeFilter(m.collected_at)\n  AND m.metric_name IN ('system_available', 'instance_available',\n                        'db_available', 'db_replication_in_sync')\n  AND m.system_id IN ($system)\n  AND $__timeTo()::timestamptz - $__timeFrom()::timestamptz <= interval '2 days'\nGROUP BY 1, 2\n\nUNION ALL\n\nSELECT $__timeGroupAlias(h.bucket, $__interval),\n       s.sid || ' ' || s.system_type || ' · ' ||\n         replace(h.metric_name, '_available', '') AS metric,\n       min(h.min_value) AS value\nFROM metrics_hourly h\nJOIN systems s ON s.id = h.system_id\nWHERE $__timeFilter(h.bucket)\n  AND h.metric_name IN ('system_available', 'instance_available',\n                        'db_available', 'db_replication_in_sync')\n  AND h.system_id IN ($system)\n  AND $__timeTo()::timestamptz - $__timeFrom()::timestamptz > interval '2 days'\nGROUP BY 1, 2\n\nORDER BY 1;",
