          "rawQuery": true,
          "rawSql": "SELECT c.name AS \"Customer\",\n       count(*) FILTER (WHERE a.severity = 'critical') AS \"Critical\",\n       count(*) FILTER (WHERE a.severity = 'warning')  AS \"Warning\",\n       count(*) FILTER (WHERE a.severity = 'info')     AS \"Info\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE a.cleared_at IS NULL\n  AND a.status IN ('open', 'flapping')\n  AND c.id IN ($customer)\nGROUP BY 1\nORDER BY count(*) DESC\nLIMIT 15;",
