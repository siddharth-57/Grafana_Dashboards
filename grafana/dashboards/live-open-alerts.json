          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.fired_at                      AS \"Fired\",\n       c.id                            AS customer_id,\n       c.name                          AS \"Customer\",\n       s.sid || ' (' || s.system_type || ')' AS \"System\",\n       a.alert_name                    AS \"Alert\",\n       a.severity                      AS \"Severity\",\n       a.status                        AS \"Status\",\n       a.metric_value                  AS \"Value\",\n       a.threshold_value               AS \"Threshold\",\n       a.occurrence_count              AS \"Occurrences\",\n       a.llm_guidance                  AS \"Guidance\"\nFROM alerts a\nJOIN systems s   ON s.id = a.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE a.cleared_at IS NULL\n  AND a.status IN ('open', 'flapping')\n  AND c.id IN ($customer)\nORDER BY CASE a.severity WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 ELSE 3 END,\n         a.fired_at;",
          "refId": "A",
          "sql": {
