      "targets": [
        {
          "dataset": "monitoring",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg0vtrrqg16o0d"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name                                                     AS \"Customer\",\n       c.customer_number                                          AS \"Number\",\n       g.name                                                     AS \"Group\",\n       max(s.sid) FILTER (WHERE s.system_type = 'PROD')           AS \"PROD\",\n       max(s.sid) FILTER (WHERE s.system_type = 'QA')             AS \"QA\",\n       max(s.sid) FILTER (WHERE s.system_type = 'DEV')            AS \"DEV\",\n       min(s.deployment_type)                                     AS \"Deployment\",\n       min(s.source)                                              AS \"Monitored via\",\n       c.created_at                                               AS \"Customer since\"\nFROM customers c\nJOIN groups g  ON g.id = c.group_id\nJOIN systems s ON s.customer_id = c.id\nGROUP BY c.id, c.name, c.customer_number, g.name, c.created_at\nORDER BY c.name;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
