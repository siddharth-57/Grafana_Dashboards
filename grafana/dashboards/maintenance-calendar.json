          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE start_at <= now() AND end_at > now())                          AS \"Active now\",\n       count(*) FILTER (WHERE start_at > now() AND start_at <= now() + interval '24 hours')   AS \"Starting in 24h\",\n       count(*) FILTER (WHERE start_at > now() AND start_at <= now() + interval '7 days')    AS \"Starting in 7 days\"\nFROM maintenance_windows;",
