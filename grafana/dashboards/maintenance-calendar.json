      "targets": [
        {
          "dataset": "monitoring",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg0vtrrqg16o0d"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN m.start_at <= now() AND m.end_at > now() THEN 'Active'\n            WHEN m.start_at > now()                       THEN 'Upcoming'\n            ELSE 'Completed' END                          AS \"Status\",\n       c.name                                             AS \"Customer\",\n       s.sid || ' (' || s.system_type || ')'              AS \"System\",\n       m.reason                                           AS \"Reason\",\n       m.start_at                                         AS \"Start\",\n       m.end_at                                           AS \"End\",\n       EXTRACT(EPOCH FROM m.end_at - m.start_at)          AS \"Duration\"\nFROM maintenance_windows m\nJOIN systems s   ON s.id = m.system_id\nJOIN customers c ON c.id = s.customer_id\nWHERE m.start_at < $__timeTo()\n  AND m.end_at   > $__timeFrom()\nORDER BY (m.start_at <= now() AND m.end_at > now()) DESC,   -- active first\n         (m.start_at > now()) DESC,                          -- then upcoming\n         m.start_at;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
