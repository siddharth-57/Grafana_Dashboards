          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.time,\n       s.sid || ' \u00b7 ' || c.name AS metric,\n       t.value\nFROM maintenance_windows m\nJOIN systems s   ON s.id = m.system_id\nJOIN customers c ON c.id = s.customer_id\nCROSS JOIN LATERAL (VALUES (m.start_at, 1), (m.end_at, 0)) AS t(time, value)\nWHERE m.start_at < $__timeTo()\n  AND m.end_at   > $__timeFrom()\nORDER BY 1;",
